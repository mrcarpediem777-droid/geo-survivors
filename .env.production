# ============================================================================
#  THIS FILE EXISTS ONLY ON THE `devtools` BRANCH. IT MUST NEVER REACH `main`.
# ============================================================================
#
# It switches the hidden developer panel ON for builds made from this branch,
# so the wall overlay, frame-rate counter and fake GPS are usable on a phone --
# which is where the testing that matters actually happens.
#
# The real game is built from `main`, which has no such file, so players get a
# build with the panel physically absent. That is the whole point of the switch.
#
# If you are ever merging this branch into main: DELETE THIS FILE FIRST.
VITE_ENABLE_DEV_TOOLS=true
