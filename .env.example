# Copy this file to `.env.local` if you want to change these on your own machine.
#
# VITE_ENABLE_DEV_TOOLS turns on the hidden developer panel (fake GPS, FPS counter).
# It is ALWAYS on when running `npm run dev` on your computer.
# It is ALWAYS off in the deployed game unless you deliberately set it to "true"
# in the Vercel dashboard. This is what stops dev cheats from reaching real players.
VITE_ENABLE_DEV_TOOLS=true
